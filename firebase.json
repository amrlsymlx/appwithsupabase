{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/reset-password/",
        "destination": "/reset-password",
        "type": 301
      },
      {
        "source": "/sign-up/",
        "destination": "/sign-up",
        "type": 301
      }
    ],
    "predeploy": [
      "npm run predeploy"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "node_modules/**"
    ]
  }
}
